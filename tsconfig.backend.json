{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "noEmit": false,
    "outDir": "backend/dist",
    "rootDir": "backend/src",
    "plugins": []
  },
  "include": ["backend/src/**/*.ts"],
  "exclude": ["node_modules", "dist", "backend/dist"]
}
