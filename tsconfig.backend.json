{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "plugins": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/app/**/*"]
}
