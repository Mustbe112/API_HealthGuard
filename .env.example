# Copy to .env and fill in real values. NEVER commit .env itself.

NODE_ENV=development
PORT=4000

# Postgres connection string
# Transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Session-mode pooler (used for migrations)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Random secret used to sign JWTs. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="replace-me"

# 32-byte key, base64, for AES-256-GCM. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="replace-me"

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional — Explain this run
GROQ_API_KEY=""
GROQ_MODEL=openai/gpt-oss-20b
